# ---- General ----
NODE_ENV=development
LOG_LEVEL=debug

# ---- Ports exposed on your machine ----
SERVER_PORT=4000
CLIENT_PORT=5173
# Host port for MongoDB (only used by tools like Compass; the app uses the Docker network)
MONGO_PORT=27018

# ---- Database ----
MONGO_DB_NAME=wassila

# ---- CORS (comma-separated list of allowed browser origins) ----
CORS_ORIGINS=http://localhost:5173

# Phase 3 will add JWT secrets here. No secrets are needed yet.